# Environment Variables for django-react-auth
APP_ENV=development
DJANGO_DEBUG=true

# Database and message broker (read by the runtime kernel)
DATABASE_URL=mysql://dev_user:dev_password@localhost:3306/django-react-auth_db
AMQP_URL=amqp://dev_user:dev_password@localhost:5672

# Security & Authentication
JWT_SECRET=<YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS>
JWT_TTL_SECONDS=3600
BCRYPT_COST_FACTOR=12

# Framework settings of the production image (from the platform secret manager in a deployment)
DJANGO_SECRET_KEY=<50+ random characters>
DJANGO_ALLOWED_HOSTS=localhost

# Serverless & Cloud Configuration
AWS_REGION=us-east-1
SERVERLESS_STAGE=dev
