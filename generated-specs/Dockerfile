# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (Python · Django + DRF).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 8000; probes: liveness /health, readiness /health.

FROM python:3.12-slim AS build
WORKDIR /app
RUN python -m venv /venv
COPY . .
RUN /venv/bin/pip install -q --no-cache-dir . gunicorn

FROM python:3.12-slim
RUN useradd --system --uid 10001 --no-create-home app
COPY --from=build /venv /venv
WORKDIR /app
COPY --from=build --chown=10001 /app /app
ENV PATH=/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Restrict DJANGO_ALLOWED_HOSTS to the service host names in each environment.
ENV DJANGO_DEBUG=false DJANGO_SETTINGS_MODULE=config.settings DJANGO_ALLOWED_HOSTS=*

USER 10001
EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
